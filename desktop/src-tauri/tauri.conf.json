{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyra",
  "version": "0.5.6",
  "identifier": "dev.nyra.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Nyra",
    "longDescription": "Nyra desktop app: a native window for the local Nyra web UI. Ships the matching nyra command-line binary.",
    "copyright": "Nyra",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "externalBin": [
      "binaries/nyra-cli"
    ]
  }
}
